{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
  "logo": {
    "type": "auto",
    "padding": { "top": 1, "left": 2, "right": 4 }
  },
  "display": {
    "separator": "  ➜  ",
    "color": { "keys": "magenta", "title": "cyan" }
  },
  "modules": [
    "title",
    "separator",
    "break",

    { "type": "custom", "format": "━━━━━━━━  System  ━━━━━━━━", "outputColor": "cyan" },
    "os",
    "kernel",
    "uptime",
    "packages",
    "shell",
    "terminal",
    "terminalfont",

    "break",
    { "type": "custom", "format": "━━━━━━━━  Hardware  ━━━━━━━━", "outputColor": "cyan" },
    { "type": "cpu", "temp": true },
    { "type": "gpu", "temp": true, "driverSpecific": true },
    "memory",
    "swap",
    "disk",
    "display",

    "break",
    { "type": "custom", "format": "━━━━━━━━  Desktop  ━━━━━━━━", "outputColor": "cyan" },
    "de",
    "wm",
    "theme",
    "icons",
    "font",
    "cursor",

    "break",
    { "type": "custom", "format": "━━━━━━━━  Extras  ━━━━━━━━", "outputColor": "cyan" },
    "sound",
    "media",
    "gamepad",
    {
      "type": "command",
      "key": "Local IP",
      "text": "ip -4 route get 1 | awk '{for(i=1;i<=NF;i++) if($i==\"src\") print $(i+1)}' | sed 's/\\.[0-9]*\\.[0-9]*$/.•••.•••/'"
    },

    "break",
    { "type": "colors", "symbol": "circle", "paddingLeft": 2 }
  ]
}
